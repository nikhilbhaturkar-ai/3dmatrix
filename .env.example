# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit real values. See ADMIN_SETUP.md for how to get each one.

# --- Admin portal login (/admin) ---
# Your admin password. Use a long one (12+ characters).
ADMIN_PASSWORD=
# Random secret (at least 32 characters) used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Google Sheet + Drive (from Google Cloud Console, see ADMIN_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by:  npm run sheet:auth
GOOGLE_REFRESH_TOKEN=
# Filled in automatically by:  npm run sheet:export
GOOGLE_SHEET_ID=
